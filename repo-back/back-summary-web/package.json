{
  "name": "sample-serverless-ms",
  "version": "1.0.0",
  "description": "Sample serverless Rest Ms",
  "apiReference": "naranja-sample-serverless-ms-api:0.0.1",
  "main": "src/index.js",
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@tn-golden-lambda/base-serverless-application": "^5.0.0",
    "config": "^1.30.0",
    "dotenv": "^16.3.1",
    "lodash": "^4.17.11",
    "moment": "^2.29.3",
    "oracledb": "^5.3.0"
  },
  "devDependencies": {
    "@tn-golden-api/functional-tests": "^4.0.0",
    "@tn-golden-api/node-dev-environment": "^3.0.0",
    "@tn-golden-lambda/ms-stack-plugin": "^9.0.0",
    "@tn-golden-api/eslint-config-naranja": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "chai": "^4.1.2",
    "cross-env": "^5.2.0",
    "dependency-check": "^3.1.0",
    "es6-plato": "^1.0.18",
    "eslint": "^8.24.0",
    "eslint-plugin-prettier": "^5.0.0",
    "ghooks": "^2.0.4",
    "mocha": "^5.1.1",
    "nodemon": "^1.18.11",
    "npm-run-all": "^4.1.3",
    "nyc": "^15.0.0",
    "prettier": "^3.0.1",
    "retire": "^1.6.0",
    "sinon": "^6.3.4",
    "sinon-chai": "^3.0.0",
    "stubby": "^4.0.0",
    "yaml-validator": "^1.3.0",
    "yadda": "^2.2.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=stubs npm-run-all -p stubs start-dev",
    "dev-real": "nodemon --exec serverless offline --stage=real",
    "start-dev": "nodemon --exec serverless offline --stage=stubs",
    "stubs": "stubby -w -s 8887 -t 7447 -a 8892 -d test/stubs/stubs-config.yaml",
    "start": "node ./src/index.js",
    "test": "mocha --exit --recursive --require ./scripts/mocha-bootload.js",
    "functional-test": "functional-tests --serviceUrl=http://localhost:3000/stubs",
    "functional-test-standalone": "functional-tests-standalone",
    "lint": "code-lint",
    "lint-fix": "code-lint --fix",
    "coverage": "nyc --reporter=text mocha --recursive --require ./scripts/mocha-bootload.js",
    "coverage-summary": "nyc --reporter=text-summary mocha --recursive --require ./scripts/mocha-bootload.js",
    "debug": "mocha --require ./scripts/mocha-bootload.js --inspect-brk --recursive",
    "complexity-test": "es6-plato -r -e .eslintrc -d reports src",
    "security-check-report": "retire --outputpath retire-report.txt",
    "security-check": "retire",
    "ci_lint": "yaml-validator .gitlab-ci.yml",
    "dependency-check": "dependency-check ./package.json && dependency-check ./package.json --unused --no-dev --entry ./src/application/routes/index.js --entry ./config/default.js --entry ./src/application/handlers/lambda.js"
  },
  "config": {
    "ghooks": {
      "pre-commit": "npm run lint && npm test && npm run ci_lint && npm run dependency-check"
    },
    "owner": "sample",
    "context": "engineeringteam"
  },
  "publishConfig": {},
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/Naranja-Digital/engineeringteam/sample-serverless-ms.git"
  },
  "keywords": [
    "template"
  ],
  "author": "Naranja",
  "license": "ISC",
  "engines": {
    "node": "^14.21.1"
  }
}
